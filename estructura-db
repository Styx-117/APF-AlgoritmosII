-- ============================================
-- ACADEMTRACK
-- PostgreSQL
-- ============================================

-- ============================================
-- TABLA: ALUMNO
-- ============================================

CREATE TABLE IF NOT EXISTS alumno (
    codigo_alumno VARCHAR(10) PRIMARY KEY,
    dni VARCHAR(8) NOT NULL UNIQUE,
    nombres VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    carrera VARCHAR(100) NOT NULL,
    ciclo INTEGER NOT NULL,

    CONSTRAINT chk_alumno_ciclo
        CHECK (ciclo > 0)
);


-- ============================================
-- TABLA: CURSO
-- ============================================

CREATE TABLE IF NOT EXISTS curso (
    codigo_curso VARCHAR(10) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    carrera VARCHAR(100) NOT NULL,
    ciclo INTEGER NOT NULL,
    horario VARCHAR(100) NOT NULL,
    capacidad INTEGER NOT NULL,

    CONSTRAINT chk_curso_ciclo
        CHECK (ciclo > 0),

    CONSTRAINT chk_curso_capacidad
        CHECK (capacidad > 0)
);


-- ============================================
-- TABLA: MATRICULA
-- ============================================

CREATE TABLE IF NOT EXISTS matricula (
    codigo_matricula VARCHAR(10) PRIMARY KEY,
    codigo_alumno VARCHAR(10) NOT NULL,
    fecha DATE NOT NULL,
    periodo VARCHAR(20) NOT NULL,

    estado VARCHAR(20) NOT NULL
        DEFAULT 'PENDIENTE',

    CONSTRAINT fk_matricula_alumno
        FOREIGN KEY (codigo_alumno)
        REFERENCES alumno(codigo_alumno),

    CONSTRAINT chk_matricula_estado
        CHECK (
            estado IN (
                'PENDIENTE',
                'CONFIRMADA',
                'ANULADA'
            )
        )
);


-- ============================================
-- TABLA: DETALLE_MATRICULA
-- ============================================

CREATE TABLE IF NOT EXISTS detalle_matricula (
    id_detalle SERIAL PRIMARY KEY,
    codigo_matricula VARCHAR(10) NOT NULL,
    codigo_curso VARCHAR(10) NOT NULL,

    CONSTRAINT fk_detalle_matricula
        FOREIGN KEY (codigo_matricula)
        REFERENCES matricula(codigo_matricula)
        ON DELETE CASCADE,

    CONSTRAINT fk_detalle_curso
        FOREIGN KEY (codigo_curso)
        REFERENCES curso(codigo_curso),

    CONSTRAINT uq_matricula_curso
        UNIQUE (codigo_matricula, codigo_curso)
);


-- ============================================
-- TABLA: TRAMITE
-- ============================================

CREATE TABLE IF NOT EXISTS tramite (
    codigo_tramite VARCHAR(10) PRIMARY KEY,
    codigo_alumno VARCHAR(10) NOT NULL,

    tipo VARCHAR(30) NOT NULL,

    fecha_solicitud DATE NOT NULL,
    fecha_limite DATE NOT NULL,

    prioridad INTEGER NOT NULL
        DEFAULT 2,

    estado VARCHAR(20) NOT NULL
        DEFAULT 'PENDIENTE',

    CONSTRAINT fk_tramite_alumno
        FOREIGN KEY (codigo_alumno)
        REFERENCES alumno(codigo_alumno),

    CONSTRAINT chk_tramite_tipo
        CHECK (
            tipo IN (
                'CONSTANCIA',
                'RETIRO_CURSO',
                'RECLAMO',
                'CAMBIO_HORARIO'
            )
        ),

    CONSTRAINT chk_tramite_estado
        CHECK (
            estado IN (
                'PENDIENTE',
                'ATENDIDO'
            )
        ),

    CONSTRAINT chk_tramite_prioridad
        CHECK (
            prioridad IN (1, 2)
        )
);


